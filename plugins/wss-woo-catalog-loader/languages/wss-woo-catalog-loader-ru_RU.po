msgid "0 means unlimited automatic loading. A value greater than 0 switches Infinite Scroll to a Load More button after that many pages."
msgstr "0 — бесконечная автозагрузка. Значение больше 0 переключит Infinite Scroll на кнопку «Показать ещё» после указанного числа страниц."

msgid "AJAX pagination"
msgstr "AJAX-пагинация"

msgid "Applied only when the separate mobile mode is enabled."
msgstr "Применяется только при включённом отдельном мобильном режиме."

msgid "Automatic pages before button"
msgstr "Автостраниц до кнопки"

msgid "Button text"
msgstr "Текст кнопки"

msgid "Cache fetched catalog pages in sessionStorage for the current browser tab."
msgstr "Кэшировать загруженные страницы каталога в sessionStorage текущей вкладки браузера."

msgid "Catalog Loader"
msgstr "Catalog Loader"

msgid "Change the URL only in AJAX pagination mode. Infinite Scroll and Load More always keep the original catalog URL."
msgstr "Менять URL только в режиме AJAX-пагинации. Infinite Scroll и «Показать ещё» всегда сохраняют исходный адрес каталога."

msgid "Compatibility:"
msgstr "Совместимость:"

msgid "Could not load products."
msgstr "Не удалось загрузить товары."

msgid "Enable"
msgstr "Включить"

msgid "Enable only when phones need a different loading method. By default mobile inherits the main mode."
msgstr "Включайте только если на телефонах нужен другой способ загрузки. По умолчанию мобильная версия наследует основной режим."

msgid "Enable the loader on WooCommerce product archives."
msgstr "Активировать загрузчик на архивах товаров WooCommerce."

msgid "Error text"
msgstr "Текст ошибки"

msgid "Hide result count"
msgstr "Скрывать счётчик результатов"

msgid "Hide text such as “Showing 1–12 of 404” in Infinite Scroll and Load More modes. AJAX pagination keeps and updates it."
msgstr "Скрывать строки вида «Отображение 1–12 из 404» в режимах Infinite Scroll и «Показать ещё». В AJAX-пагинации счётчик сохраняется и обновляется."

msgid "History API for AJAX pagination"
msgstr "History API для AJAX-пагинации"

msgid "In Infinite Scroll mode, loading starts before the end of the catalog reaches the viewport."
msgstr "В режиме Infinite Scroll запрос начинается до появления конца каталога в области просмотра."

msgid "Infinite scroll"
msgstr "Бесконечная прокрутка"

msgid "Load More button"
msgstr "Кнопка «Показать ещё»"

msgid "Load more"
msgstr "Показать ещё"

msgid "Loading products…"
msgstr "Загружаем товары…"

msgid "Loading text"
msgstr "Текст загрузки"

msgid "Main mode"
msgstr "Основной режим"

msgid "Mobile breakpoint, px"
msgstr "Мобильный breakpoint, px"

msgid "Mobile mode"
msgstr "Режим на мобильных"

msgid "Modern catalog loading without jQuery. The plugin requests the next regular WooCommerce page and imports its product cards, which keeps classic archive templates, sorting and URL-based filters compatible."
msgstr "Современная загрузка каталога без jQuery. Плагин запрашивает следующую обычную страницу WooCommerce и импортирует её карточки товаров, сохраняя совместимость с классическими шаблонами архивов, сортировкой и URL-фильтрами."

msgid "Next page link"
msgstr "Ссылка Next"

msgid "Pagination"
msgstr "Пагинация"

msgid "Preload distance, px"
msgstr "Предзагрузка, px"

msgid "Product item"
msgstr "Товар"

msgid "Products container"
msgstr "Контейнер товаров"

msgid "Result count"
msgstr "Счётчик результатов"

msgid "Retry text"
msgstr "Текст повтора"

msgid "Separate mobile mode"
msgstr "Отдельный режим на мобильных"

msgid "Session cache"
msgstr "Session cache"

msgid "Settings"
msgstr "Настройки"

msgid "The defaults match classic WooCommerce markup. Change these only for a custom classic theme."
msgstr "Значения по умолчанию соответствуют классической разметке WooCommerce. Меняйте их только для нестандартной классической темы."

msgid "Theme selectors"
msgstr "Селекторы темы"

msgid "Try again"
msgstr "Повторить"

msgid "Used on desktop and mobile unless the separate mobile mode is enabled."
msgstr "Используется на компьютере и мобильных, если отдельный мобильный режим не включён."

msgid "Version 1.1 targets classic WooCommerce product archives. Product Collection Blocks keep their native WooCommerce behavior and are not modified."
msgstr "Версия 1.1 предназначена для классических архивов товаров WooCommerce. Product Collection Blocks сохраняют штатное поведение WooCommerce и не изменяются."

msgid "WSS Woo Catalog Loader"
msgstr "WSS Woo Catalog Loader"

msgid "WSS Woo Catalog Loader requires WooCommerce to be installed and active."
msgstr "Для работы WSS Woo Catalog Loader требуется установленный и активный WooCommerce."

msgid "Yes"
msgstr "Да"
