msgstr "Booking not found."

#: includes/class-wss-wcb-yc-plugin.php
msgid "Прошедшие бронирования не синхронизируются."
msgstr "Past bookings are not synchronized."

#: includes/class-wss-wcb-yc-plugin.php
msgid "У бронирования нет активного заказа и ещё нет события в календаре."
msgstr "The booking has no active order and no existing calendar event."

#: includes/class-wss-wcb-yc-plugin.php
msgid "Пометка отменённых событий доступна в Pro-версии."
msgstr "Cancellation markers are available in Pro."

#: includes/class-wss-wcb-yc-plugin.php
msgid "Заполните Email Яндекса, пароль приложения и CalDAV URL календаря."
msgstr "Enter your Yandex email, app password and calendar CalDAV URL."

